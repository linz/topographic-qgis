                    <Option name="Color" type="Map">
                      <Option name="active" type="bool" value="false"/>
                      <Option name="expression" type="QString" value="case when  &quot;text_colour&quot; = 5 then 'red'&#xa;&#x9;when   &quot;text_colour&quot; = 6 then '#0083bb'&#xa;&#x9;when &quot;text_colour&quot; = 5 then 'blue'&#xa;&#x9;when  &quot;text_colour&quot; = 1680 then 'purple'&#xa;&#x9;end"/>
                      <Option name="type" type="int" value="3"/>
