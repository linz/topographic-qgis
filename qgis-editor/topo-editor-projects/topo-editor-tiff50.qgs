                      <Option name="expression" type="QString" value="case &#xa;when strpos(  &quot;text_font&quot; , 'CondBold')>0 then 'Condensed Bold' &#xa;when strpos(  &quot;text_font&quot; , 'CondItalic')>0 then 'Condensed Italic' &#xa;when strpos(  &quot;text_font&quot; , 'Italic')>0 then 'Italic' &#xa;when strpos(  &quot;text_font&quot; , 'Cond')>0 then 'Condensed' &#xa;when strpos(  &quot;text_font&quot; , 'Regular')>0 then 'Regular' &#xa;end"/>
                      <Option name="type" type="int" value="3"/>
