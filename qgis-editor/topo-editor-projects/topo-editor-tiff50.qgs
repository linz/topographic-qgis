          <rule description="Right side DMS labels" filter="&quot;direction&quot; ='x' and round(&quot;value&quot; * 60) %5 = 0" key="{ae30cf35-b7a4-46c4-8f39-6fd87b015a48}">
            <settings calloutType="simple">
              <text-style fontSizeMapUnitScale="3x:0,0,0,0,0,0" fontUnderline="0" multilineHeight="0.69999999999999996" forcedBold="0" blendMode="0" tabStopDistanceUnit="Point" textOrientation="horizontal" forcedItalic="0" fontKerning="1" fontWordSpacing="0" previewBkgrdColor="255,255,255,255,rgb:1,1,1,1" fontItalic="0" namedStyle="Condensed" allowHtml="0" fontStrikeout="0" fontSizeUnit="Point" tabStopDistanceMapUnitScale="3x:0,0,0,0,0,0" fieldName="with_variable('value', abs(&quot;value&quot;),&#xa;&#xa;concat(@value//1, '°\n',&#xa;round((@value-floor(@value))*60), '′'&#xa;&#xa;)&#xa;)" multilineHeightUnit="Percentage" fontLetterSpacing="0" tabStopDistance="80" fontSize="6" useSubstitutions="0" fontWeight="50" capitalization="0" textOpacity="1" isExpression="1" fontFamily="AT Triumvirate Mou" textColor="50,50,50,255,rgb:0.1960784,0.1960784,0.1960784,1" legendString="Aa">
