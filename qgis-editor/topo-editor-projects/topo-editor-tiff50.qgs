                      <Option name="active" type="bool" value="false"/>
                      <Option name="expression" type="QString" value="case when  &quot;text_place&quot; in ( 1, 4, 31) then 'AL' when &quot;text_place&quot; = 2 then 'OL' else 'BL' end"/>
                      <Option name="type" type="int" value="3"/>
                    </Option>
                    <Option name="Size" type="Map">
                      <Option name="active" type="bool" value="true"/>
                      <Option name="expression" type="QString" value="case when &quot;text_height&quot; &lt; 1 then  case when strpos( &quot;text_font&quot; ,'Italic')> 0 then &quot;text_height&quot; *4000&#xa;when strpos( &quot;text_font&quot; ,'Cond')> 0 then &quot;text_height&quot; *4000&#xa;else &quot;text_height&quot; * 2600 end&#xa;&#xa;when &quot;text_height&quot; &lt; 20 then &quot;text_height&quot; &#xa;&#xa;else &quot;text_height&quot; / 12&#xa;end"/>
                      <Option name="type" type="int" value="3"/>
                    </Option>
