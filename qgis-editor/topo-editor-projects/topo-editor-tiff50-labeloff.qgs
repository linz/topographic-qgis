            <settings calloutType="simple">
              <text-style useSubstitutions="0" multilineHeight="0.69999999999999996" forcedItalic="0" fontUnderline="0" textColor="50,50,50,255,rgb:0.1960784,0.1960784,0.1960784,1" previewBkgrdColor="255,255,255,255,rgb:1,1,1,1" fontFamily="AT Triumvirate Mou" fontItalic="0" tabStopDistanceMapUnitScale="3x:0,0,0,0,0,0" blendMode="0" fontSize="6" namedStyle="Condensed" legendString="Aa" fieldName="with_variable('value', abs(&quot;value&quot;),&#xa;&#xa;concat(@value//1, '°\n',&#xa;round((@value-floor(@value))*60), '′'&#xa;&#xa;)&#xa;)" fontSizeUnit="Point" fontStrikeout="0" fontWeight="50" fontSizeMapUnitScale="3x:0,0,0,0,0,0" fontKerning="1" stretchFactor="100" tabStopDistanceUnit="Point" forcedBold="0" fontWordSpacing="0" isExpression="1" tabStopDistance="80" fontLetterSpacing="0" textOrientation="horizontal" textOpacity="1" capitalization="0" multilineHeightUnit="Percentage" allowHtml="0">
